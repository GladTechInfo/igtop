# Maintainer: lukazibi83 <205174930+lukazibi83@users.noreply.github.com>
#
# Source of truth for the AUR package. The release workflow
# (.github/workflows/aur.yml) sets pkgver and the checksum from each GitHub
# release and pushes this file with its .SRCINFO to the AUR, so pkgver here
# may lag the latest release; the AUR copy is always current.

pkgname=igtop
pkgver=0.1.1
pkgrel=1
pkgdesc='Terminal monitor for Intel GPUs on the i915 driver, with per-engine utilisation and per-container attribution'
arch=('x86_64')
url='https://github.com/lukazibi83/igtop'
license=('GPL-3.0-or-later')
depends=('libgcc' 'glibc')
makedepends=('cargo')
optdepends=('hwdata: GPU model names')
# The release profile strips the binary, so a -debug package would be empty.
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('d0dffea4e041fa738c6679fe9d369ac3b06a1a46d023f92e46877bfd9bffad7a')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm0755 -t "$pkgdir/usr/bin/" target/release/igtop
  install -Dm0644 -t "$pkgdir/usr/share/doc/$pkgname/" README.md
}
